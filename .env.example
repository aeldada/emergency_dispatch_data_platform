# SODA API (DataSF)
SODA_APP_TOKEN=

# AWS — ingestion (Python → S3). Access key of the ingestion user (G-06, S2); no AWS_PROFILE in containers.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

# Snowflake — pipeline (Airflow / COPY INTO / dbt)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=PIPELINE_USER
SNOWFLAKE_ROLE=PIPELINE_ROLE
SNOWFLAKE_WAREHOUSE=DISPATCH_WH
SNOWFLAKE_DATABASE=EMERGENCY_DISPATCH
# Folder with the private keys on the host; mounted read-only at /keys in Docker (D-52)
SNOWFLAKE_KEYS_DIR=
# Path to the .p8 file (on the Mac: the file in SNOWFLAKE_KEYS_DIR; in Docker: /keys/pipeline_key.p8)
SNOWFLAKE_PRIVATE_KEY_PATH=

# Snowflake — reader (Streamlit)
SNOWFLAKE_READER_USER=READER_USER
SNOWFLAKE_READER_ROLE=READER_ROLE
# Path to the .p8 file (in Docker: /keys/reader_key.p8)
SNOWFLAKE_READER_PRIVATE_KEY_PATH=
